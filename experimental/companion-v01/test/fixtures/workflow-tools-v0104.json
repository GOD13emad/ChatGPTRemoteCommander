  {
    "name": "workflow_create",
    "description": "Create a persistent project goal and ordered/DAG steps. Credentials are forbidden.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "dependsOn": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                }
              }
            },
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "executionProfile": {
          "type": "object",
          "properties": {
            "modelFamily": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "modelVariant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "reasoningEffort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "executionMode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "profileVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "fallbackPolicy": {
              "type": "string",
              "enum": [
                "equivalent-or-better",
                "exact-only",
                "allow-any"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "brainPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "autoContinue": {
          "type": "boolean"
        },
        "retryBudget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "required": [
        "id",
        "root",
        "goal",
        "acceptance",
        "steps"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
