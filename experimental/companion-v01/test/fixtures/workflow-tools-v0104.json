  {
    "name": "workflow_note",
    "description": "Append typed project knowledge with provenance/status and revision precondition.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "kind": {
          "type": "string",
          "enum": [
            "fact",
            "inference",
            "proposal",
            "assumption",
            "decision",
            "failure",
            "root_cause",
            "evidence",
            "handoff"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "status": {
          "type": "string",
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "UNVERIFIED",
            "MISSING",
            "CONTRADICTORY"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reuseTargets": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "expectedRevision",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
