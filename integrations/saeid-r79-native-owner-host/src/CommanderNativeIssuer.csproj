<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot><SelfContained>true</SelfContained><InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion><IlcPackageVersion>10.0.14</IlcPackageVersion><DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>CommanderNativeIssuer</AssemblyName><ApplicationManifest>host.manifest</ApplicationManifest>
  </PropertyGroup>
  <Target Name="RequireFrozenSourceAdmission" BeforeTargets="PrepareForBuild"><Error Condition="'$(FrozenR78SourceRoot)'=='' Or !Exists('$(FrozenR78SourceRoot)/reviews/durable/local-owner-auth/protected-oauth-exchange/ProtectedOAuthExchange.cs')" Text="Explicit build-time FrozenR78SourceRoot and verified source manifest required."/></Target>
  <Target Name="VerifyFrozenSourcePins" BeforeTargets="CoreCompile">
    <ItemGroup><_PinnedFrozen Include="@(Compile)" Condition="'%(Compile.ExpectedHash)'!=''"/></ItemGroup>
    <GetFileHash Files="@(_PinnedFrozen)" Algorithm="SHA256" MetadataName="ObservedHash"><Output TaskParameter="Items" ItemName="_ObservedFrozen"/></GetFileHash>
    <Error Condition="'%(_ObservedFrozen.ObservedHash)'!='%(_ObservedFrozen.ExpectedHash)'" Text="Frozen R78 source changed: %(_ObservedFrozen.Identity). Do not compile an unreviewed dependency."/>
  </Target>
  <ItemGroup>
    <Compile Include="Program.cs"/><Compile Include="IssuerProtocol.cs"/><Compile Include="HostPolicy.cs"/><Compile Include="KernelPeer.cs"/><Compile Include="PrivatePipe.cs"/>
    <Compile Include="$(FrozenR78SourceRoot)/reviews/durable/local-owner-auth/protected-oauth-exchange/ProtectedOAuthExchange.cs" Link="Frozen/ProtectedOAuthExchange.cs" ExpectedHash="277BEB1F077289203EE57AB3DF55AC64D8E7BFCA2D0AA0B31A25AAAF5D208AE0"/>
    <Compile Include="$(FrozenR78SourceRoot)/reviews/durable/local-owner-auth/protected-oauth-exchange/ExchangeJournal.cs" Link="Frozen/ExchangeJournal.cs" ExpectedHash="E79149D2CB090771A9705890AE113F32251D69300FCB79F739024AA8E40A91C8"/>
    <Compile Include="$(FrozenR78SourceRoot)/reviews/durable/local-owner-auth/protected-issuer-state/ProtectedIssuerState.cs" Link="Frozen/ProtectedIssuerState.cs" ExpectedHash="F9DAF6BDC0A641F1527B07EFADFD8F9F36CB3047E8E22B574A00FAC60435CC82"/>
    <Compile Include="$(FrozenR78SourceRoot)/reviews/durable/local-owner-auth/native-consent-aot-j/OwnerConsentCore.cs" Link="Frozen/OwnerConsentCore.cs" ExpectedHash="684DD5D8EFDC9A90C6D00E1EE6ADB7A04BDF3563D716FA9E2DC76C8FAB28D663"/>
    <Compile Include="$(FrozenR78SourceRoot)/reviews/durable/local-owner-auth/native-consent-aot-j/WindowsGuard.cs" Link="Frozen/WindowsGuard.cs" ExpectedHash="30D773DE2FDE0A50F5519961F0D19EBBEB59BF6F6346F7D3BC9301F4F79EC0B5"/>
    <Compile Include="$(FrozenR78SourceRoot)/reviews/durable/local-owner-auth/native-consent-aot-j/SystemDllPolicy.cs" Link="Frozen/SystemDllPolicy.cs" ExpectedHash="916E611FD3DFBD23614E774B134F0A5F90FCBECBDC385E53B15D03E32A6D2347"/>
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800"/>
  </ItemGroup>
  <ItemGroup Condition="'$(ProtocolFixtureOnly)'=='true'"><Compile Include="ProtocolQA.cs"/></ItemGroup>
</Project>
