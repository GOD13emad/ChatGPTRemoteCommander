  <ItemGroup><Compile Include="OwnerConsentCore.cs"/><Compile Include="WindowsGuard.cs"/><Compile Include="NativeAotOwnerConsent.cs"/><Compile Include="JsonOutput.cs"/><Compile Include="NativeDialog.cs"/><Compile Include="SystemDllPolicy.cs"/><LinkerArg Include="/DEPENDENTLOADFLAG:0x800"/></ItemGroup>
