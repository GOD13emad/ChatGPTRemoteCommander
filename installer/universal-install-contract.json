    "commonStages": [
      "inspect-package",
      "inspect-baseline",
      "plan",
      "owner-approval",
      "exclusive-lock",
      "native-effect",
      "verify-runtime-identity",
      "commit-or-rollback",
      "reconcile-uncertain-result"
