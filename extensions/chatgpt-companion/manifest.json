{
  "manifest_version": 3,
  "name": "Commander Chat Companion",
  "version": "0.1.0",
  "description": "Opt-in, scoped ChatGPT tab presence for Remote Commander. No chat text, cookies, or commands.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:41267/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Commander Chat Companion"
  }
}
