    "missing remote commander tool",
    "Commander missing permission",
    "Remote Commander limitation",
    "کمبود قابلیت کامندر",
    "محدودیت ریموت کامندر",
    "ابزار کامندر موجود نیست",
    "مشکل دسترسی کامندر",
    "مجوز ادمین کامندر",
    "ثبت مشکل کامندر",
    "missing Commander tool",
    "Commander permission blocked",
    "Full Access unavailable",
    "قابلیت کامندر موجود نیست",
    "محدودیت کامندر",
    "مجوز کامندر"
  ],
  "skill": "SKILL.md",
  "safetyGates": [
    "owner-profile-only",
    "no-os-elevation",
    "no-credential-storage",
    "no-cross-owner-access",
    "evidence-required",
    "release-not-implied"
  ],
  "metadata": {
