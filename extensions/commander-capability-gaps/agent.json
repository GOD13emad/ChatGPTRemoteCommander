{
  "schemaVersion": 1,
  "id": "commander-capability-gaps",
  "version": "0.2.1-rc.1",
  "displayName": "Commander Capability Gap Reporting",
  "description": "Default owner-scoped capability-gap reporting and triage using the pinned portable CLI; historical V1 JSON registry is separately available for explicit legacy queries, with no implicit migration or credential access.",
  "capabilities": [
    "commander.capability-gap.report",
    "commander.capability-gap.triage",
    "commander.missing-tool-discovery"
  ],
  "triggers": [
