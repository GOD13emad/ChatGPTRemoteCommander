{
  "schemaVersion": 1,
  "id": "coucou-bridge",
  "version": "0.1.0",
  "displayName": "Coucou Bridge - Read-only Commander Status",
  "description": "Optional local-only display of accepted Commander workflow lifecycle and operation status. No approvals, commands, browser login state or authenticated ChatGPT delivery authority.",
  "capabilities": [
    "monitor.coucou",
    "workflow.lifecycle-display",
    "commander.operation-display"
  ],
  "triggers": [
    "coucou",
    "coucou bridge",
    "remote commander floating monitor",
    "کوکو",
    "مانیتورینگ شناور"
  ],
  "skill": "SKILL.md",
  "runtimeDependencies": [
    {
      "id": "coucou.hook",
      "kind": "tool",
      "required": false,
      "source": "https://github.com/Louis-CFM/coucou"
    }
  ],
  "safetyGates": [
    "opt-in.disabled-by-default",
    "privacy.fixed-labels-only",
    "privacy.no-credentials",
    "no-approval-delegation",
    "no-cross-device-automatic-install",
    "no-chat-delivery-claim"
  ],
  "artifacts": [
    "system-status.coucouBridge",
    "coucou-local-status-events",
    "bridge-regression-evidence"
  ],
  "metadata": {
    "ownerScope": "Emad/Saeid permitted; MMZ excluded",
    "platforms": [
      "win32",
      "linux"
    ],
    "mmzInstallAllowed": false,
    "ownerConsent": "Required before enabling Coucou",
    "bridgeMode": "display-only-best-effort",
    "sourceState": "DRAFT_NOT_RELEASED",
    "noNewAuthority": true
  }
}
